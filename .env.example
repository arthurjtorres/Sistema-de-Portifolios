# Configuração pública do app Web do Firebase (Console > Configurações do projeto > Seus apps).
# Valores VITE_ são embutidos no bundle do navegador: NÃO são segredos e não devem conter
# credenciais administrativas. Copie este arquivo para `.env.local` e preencha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" conecta o app aos emuladores locais (Auth 9099, Firestore 8080, Storage 9199).
# Com emuladores, as chaves acima podem usar valores fictícios e o PROJECT_ID deve ser
# "demo-portfolio-manager" (prefixo demo- = nenhum recurso real é acessado).
VITE_USE_FIREBASE_EMULATORS=false
